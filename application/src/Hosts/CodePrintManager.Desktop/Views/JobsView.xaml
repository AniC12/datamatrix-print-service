<UserControl x:Class="CodePrintManager.Desktop.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CodePrintManager.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:JobsViewModel}"
             Loaded="OnLoaded">
    <TabControl>
        <!-- Active Jobs -->
        <TabItem Header="Active Jobs">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8">
                    <Button Content="Cancel Selected" Command="{Binding CancelJobCommand}" Padding="12,6" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding ActiveJobs}" SelectedItem="{Binding SelectedJob}"
                          AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" />
                        <DataGridTextColumn Header="Product" Binding="{Binding Product.Name}" Width="*" />
                        <DataGridTextColumn Header="Printer" Binding="{Binding Printer.Name}" Width="120" />
                        <DataGridTextColumn Header="Progress" Binding="{Binding CodesConfirmed}" Width="80" />
                        <DataGridTextColumn Header="Total" Binding="{Binding Quantity}" Width="80" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- Job History -->
        <TabItem Header="History">
            <DataGrid ItemsSource="{Binding JobHistory}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" />
                    <DataGridTextColumn Header="Product" Binding="{Binding Product.Name}" Width="*" />
                    <DataGridTextColumn Header="Printer" Binding="{Binding Printer.Name}" Width="120" />
                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="80" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                    <DataGridTextColumn Header="Completed" Binding="{Binding CompletedAt, StringFormat=g}" Width="140" />
                </DataGrid.Columns>
            </DataGrid>
        </TabItem>
    </TabControl>
</UserControl>
