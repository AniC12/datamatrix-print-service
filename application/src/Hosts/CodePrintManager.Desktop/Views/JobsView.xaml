<UserControl x:Class="CodePrintManager.Desktop.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CodePrintManager.Desktop.ViewModels"
             xmlns:loc="clr-namespace:CodePrintManager.Desktop.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:JobsViewModel}"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="{loc:Loc Common_NewJob}"
                    Command="{Binding NewJobCommand}"
                    Style="{StaticResource PrimaryButton}" Padding="16,8" />
            <TextBlock Text="{loc:Loc Jobs_Title}" Style="{StaticResource PageHeader}" VerticalAlignment="Center" />
        </DockPanel>

        <TabControl Grid.Row="1">
            <!-- Active Jobs Tab -->
            <TabItem Header="{loc:Loc Jobs_Tab_ActiveJobs}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Job Selector -->
                    <TextBlock Grid.Row="0" Text="{loc:Loc Jobs_SelectJob}" Margin="0,8,0,4" Opacity="0.6"
                               Visibility="{Binding HasActiveJobs, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MaxHeight="150" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ListBox Grid.Row="0" ItemsSource="{Binding ActiveJobs}"
                                 SelectedItem="{Binding SelectedJob}" Margin="0,0,0,8"
                                 Visibility="{Binding HasActiveJobs, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,8,0"
                                                 Fill="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />
                                        <TextBlock>
                                            <Run Text="#" /><Run Text="{Binding Id, Mode=OneWay}" />
                                            <Run Text="  " />
                                            <Run Text="{Binding Product.Name, Mode=OneWay}" />
                                            <Run Text=" → " />
                                            <Run Text="{Binding Printer.Name, Mode=OneWay}" />
                                            <Run Text="       " />
                                            <Run Text="{Binding CodesConfirmed, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding Quantity, Mode=OneWay}" />
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Separator Grid.Row="1" />

                        <!-- Job Detail Area -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <StackPanel Visibility="{Binding SelectedJob, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock FontSize="16" FontWeight="Bold" Margin="0,0,0,12">
                                    <Run Text="{loc:Loc Dashboard_JobPrefix}" /><Run Text="{Binding SelectedJob.Id, Mode=OneWay}" />
                                </TextBlock>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Jobs_Label_Product}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding JobDetailProduct}" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Jobs_Label_Printer}" FontWeight="SemiBold" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="{Binding JobDetailPrinter}" />
                                        <Ellipse Style="{StaticResource StatusDot}" Margin="8,0,4,0"
                                                 Fill="{Binding JobDetailStatus, Converter={StaticResource StatusToColorConverter}}" />
                                        <TextBlock Text="{Binding JobDetailStatus}"
                                                   Foreground="{Binding JobDetailStatus, Converter={StaticResource StatusToColorConverter}}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Jobs_Label_Quantity}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1">
                                        <Run Text="{Binding JobDetailQuantity, Mode=OneWay}" />
                                        <Run Text="{loc:Loc Jobs_Codes}" />
                                    </TextBlock>
                                </Grid>

                                <!-- Preparation Checklist -->
                                <TextBlock Text="{loc:Loc Jobs_Preparation}" Style="{StaticResource SectionHeader}" Margin="0,4,0,4" />
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource CheckmarkLabel}">
                                        <Run Text="{Binding PrepTemplatePresent, Mode=OneWay, Converter={StaticResource BoolToCheckmarkConverter}}" />
                                        <Run Text="{loc:Loc Jobs_Prep_TemplatePresent}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource CheckmarkLabel}">
                                        <Run Text="{Binding PrepCodesReserved, Mode=OneWay, Converter={StaticResource BoolToCheckmarkConverter}}" />
                                        <Run Text="{loc:Loc Jobs_Prep_CodesReserved}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource CheckmarkLabel}">
                                        <Run Text="{Binding PrepDataUploaded, Mode=OneWay, Converter={StaticResource BoolToCheckmarkConverter}}" />
                                        <Run Text="{loc:Loc Jobs_Prep_DataUploaded}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource CheckmarkLabel}">
                                        <Run Text="{Binding PrepTemplateLoaded, Mode=OneWay, Converter={StaticResource BoolToCheckmarkConverter}}" />
                                        <Run Text="{loc:Loc Jobs_Prep_TemplateLoaded}" />
                                    </TextBlock>
                                </StackPanel>

                                <!-- Progress -->
                                <TextBlock Text="{loc:Loc Jobs_PrintProgress}" Style="{StaticResource SectionHeader}" Margin="0,8,0,4" />
                                <TextBlock Text="{Binding JobDetailProgressText}" Margin="0,0,0,4" />
                                <ProgressBar Value="{Binding JobDetailProgress}" Maximum="{Binding JobDetailQuantity}"
                                             Height="10" Margin="0,0,0,16" />

                                <!-- Action buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="{loc:Loc Dashboard_StartPrint}" Command="{Binding StartPrintCommand}"
                                            Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,8,0"
                                            Visibility="{Binding JobDetailStatus, Converter={StaticResource JobStatusToActionVisibilityConverter}, ConverterParameter=StartPrint}" />
                                    <Button Content="{loc:Loc Dashboard_Pause}" Command="{Binding PauseJobCommand}"
                                            Style="{StaticResource OutlineButton}" Padding="14,6" Margin="0,0,8,0"
                                            Visibility="{Binding JobDetailStatus, Converter={StaticResource JobStatusToActionVisibilityConverter}, ConverterParameter=Pause}" />
                                    <Button Content="{loc:Loc Dashboard_Resume}" Command="{Binding ResumeJobCommand}"
                                            Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,8,0"
                                            Visibility="{Binding JobDetailStatus, Converter={StaticResource JobStatusToActionVisibilityConverter}, ConverterParameter=Resume}" />
                                    <Button Content="{loc:Loc Dashboard_Cancel}" Command="{Binding CancelJobCommand}"
                                            Style="{StaticResource DangerButton}" Padding="14,6"
                                            Visibility="{Binding JobDetailStatus, Converter={StaticResource JobStatusToActionVisibilityConverter}, ConverterParameter=Cancel}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Empty state (after ScrollViewer so it renders on top and receives clicks) -->
                        <StackPanel Grid.Row="0" Grid.RowSpan="3"
                                    Visibility="{Binding HasActiveJobs, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,48,0,0">
                            <TextBlock Text="{loc:Loc Jobs_NoActiveJobs}" FontSize="16" Opacity="0.5" HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <Button Content="{loc:Loc Common_NewJob}" Command="{Binding NewJobCommand}"
                                    Style="{StaticResource PrimaryButton}" Padding="16,8" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Job History Tab -->
            <TabItem Header="{loc:Loc Jobs_Tab_JobHistory}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Filters -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,8">
                        <TextBlock Text="{loc:Loc Jobs_Filters}" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.6" />
                        <ComboBox ItemsSource="{Binding FilterPrinters}" SelectedItem="{Binding FilterPrinter}"
                                  DisplayMemberPath="Name" MinWidth="140" Margin="0,0,8,0">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="IsEditable" Value="False" />
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <ComboBox ItemsSource="{Binding FilterProducts}" SelectedItem="{Binding FilterProduct}"
                                  DisplayMemberPath="Name" MinWidth="140" Margin="0,0,8,0" />
                        <Button Content="{loc:Loc Common_Clear}" Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource LinkButton}" Padding="8,4" />
                    </StackPanel>

                    <!-- History Table -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding JobHistory}"
                              SelectedItem="{Binding SelectedHistoryJob}"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Jobs_Col_Id}" Binding="{Binding Id}" Width="50" />
                            <DataGridTextColumn Header="{loc:Loc Jobs_Col_Product}" Binding="{Binding Product.Name}" Width="*" />
                            <DataGridTextColumn Header="{loc:Loc Jobs_Col_Printer}" Binding="{Binding Printer.Name}" Width="120" />
                            <DataGridTextColumn Header="{loc:Loc Jobs_Col_Qty}" Binding="{Binding Quantity}" Width="70" />
                            <DataGridTextColumn Header="{loc:Loc Jobs_Col_Status}" Binding="{Binding Status}" Width="90" />
                            <DataGridTextColumn Header="{loc:Loc Jobs_Col_Date}" Binding="{Binding CompletedAt, StringFormat=MMM d}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Expanded detail for selected history job -->
                    <Border Grid.Row="2" Margin="0,8,0,0" Padding="12"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4"
                            Visibility="{Binding SelectedHistoryJob, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Margin="0,0,0,4">
                                <Run Text="{loc:Loc Dashboard_JobPrefix}" /><Run Text="{Binding SelectedHistoryJob.Id, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="{loc:Loc Jobs_Label_Product}" FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedHistoryJob.Product.Name, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="{loc:Loc Jobs_Label_Printer}" FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedHistoryJob.Printer.Name, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="{loc:Loc Jobs_Label_Quantity}" FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedHistoryJob.CodesConfirmed, Mode=OneWay}" />
                                <Run Text=" / " />
                                <Run Text="{Binding SelectedHistoryJob.Quantity, Mode=OneWay}" />
                                <Run Text="{loc:Loc Jobs_Printed}" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="{loc:Loc Jobs_Label_Result}" FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedHistoryJob.Status, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
