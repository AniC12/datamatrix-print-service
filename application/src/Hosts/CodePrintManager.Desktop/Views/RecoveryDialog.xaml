<Window x:Class="CodePrintManager.Desktop.Views.RecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CodePrintManager.Desktop.ViewModels"
        xmlns:loc="clr-namespace:CodePrintManager.Desktop.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc Recovery_Title}" Height="480" Width="1000"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        d:DataContext="{d:DesignInstance vm:RecoveryViewModel}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"
                   Text="{loc:Loc Recovery_Message}" 
                   TextWrapping="Wrap" />

        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  BorderBrush="#E0E0E0" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Loc Recovery_Col_Job}" Binding="{Binding JobId}" Width="50" />
                <DataGridTextColumn Header="{loc:Loc Recovery_Col_Status}" Binding="{Binding JobStatus}" Width="70" />
                <DataGridTextColumn Header="{loc:Loc Recovery_Col_Product}" Binding="{Binding ProductName}" Width="120" />
                <DataGridTextColumn Header="{loc:Loc Recovery_Col_Printer}" Binding="{Binding PrinterName}" Width="100" />
                <DataGridTextColumn Header="{loc:Loc Recovery_Col_AppSays}" Binding="{Binding AppConfirmed}" Width="60" />
                <DataGridTextColumn Header="{loc:Loc Recovery_Col_PrinterSays}" Binding="{Binding PrinterConfirmed}" Width="70" />
                <DataGridTextColumn Header="{loc:Loc Recovery_Col_Delta}" Binding="{Binding DeltaDisplay}" Width="50" />
                <DataGridTextColumn Header="{loc:Loc Recovery_Col_Flags}" Binding="{Binding Flags}" Width="120" />
                <DataGridTextColumn Header="{loc:Loc Recovery_Col_Action}" Binding="{Binding Recommendation}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Loc Recovery_ResumeSelected}" Command="{Binding ResumeCommand}" 
                    Padding="16,8" Margin="0,0,8,0"
                    Background="#4CAF50" Foreground="White" FontWeight="SemiBold" />
            <Button Content="{loc:Loc Recovery_AbortSelected}" Command="{Binding AbortCommand}" 
                    Padding="16,8"
                    Background="#F44336" Foreground="White" FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>
