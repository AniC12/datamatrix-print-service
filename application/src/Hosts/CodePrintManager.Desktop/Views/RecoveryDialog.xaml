<Window x:Class="CodePrintManager.Desktop.Views.RecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CodePrintManager.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="Job Recovery" Height="400" Width="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        d:DataContext="{d:DesignInstance vm:RecoveryViewModel}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="The following jobs were interrupted. Please resolve them before continuing."
                   TextWrapping="Wrap" Margin="0,0,0,16" />

        <DataGrid Grid.Row="1" ItemsSource="{Binding StaleJobs}" SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Job ID" Binding="{Binding Job.Id}" Width="60" />
                <DataGridTextColumn Header="Product" Binding="{Binding Job.Product.Name}" Width="*" />
                <DataGridTextColumn Header="Printer" Binding="{Binding Job.Printer.Name}" Width="120" />
                <DataGridTextColumn Header="Progress" Binding="{Binding Job.CodesConfirmed}" Width="80" />
                <DataGridTextColumn Header="Discrepancy" Binding="{Binding Discrepancy}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Resume" Command="{Binding ResumeJobCommand}" Padding="16,8" Margin="0,0,8,0" />
            <Button Content="Cancel Job" Command="{Binding CancelJobCommand}" Padding="16,8" />
        </StackPanel>
    </Grid>
</Window>
