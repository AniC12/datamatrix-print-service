<UserControl x:Class="CodePrintManager.Desktop.Views.NewJobView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CodePrintManager.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:NewJobViewModel}"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Back"
                    Command="{Binding GoBackCommand}"
                    IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource OutlineButton}" Padding="12,6" />
            <TextBlock Text="NEW JOB" Style="{StaticResource PageHeader}" VerticalAlignment="Center" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="550">
                <!-- Product selector -->
                <TextBlock Text="Product:" Margin="0,0,0,4" />
                <DockPanel Margin="0,0,0,16">
                    <TextBlock DockPanel.Dock="Right" Opacity="0.6" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Run Text="(" /><Run Text="{Binding AvailableCodes, Mode=OneWay}" /><Run Text=" available)" />
                    </TextBlock>
                    <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                              DisplayMemberPath="Name" />
                </DockPanel>

                <!-- Printer selector -->
                <TextBlock Text="Printer:" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}"
                          DisplayMemberPath="Name" Margin="0,0,0,16" />

                <!-- Quantity -->
                <TextBlock Text="Quantity:" Margin="0,0,0,4" />
                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                <!-- Prepare button -->
                <Button Content="Prepare" Command="{Binding PrepareCommand}"
                        IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}"
                        Style="{StaticResource PrimaryButton}" Padding="24,10" FontWeight="Bold"
                        HorizontalAlignment="Left" Margin="0,0,0,16"
                        Visibility="{Binding PrepComplete, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}" />

                <!-- Preparation Progress -->
                <Border Visibility="{Binding ShowPrepProgress, Converter={StaticResource BoolToVisibilityConverter}}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4"
                        Padding="16,12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Preparation Progress" FontWeight="Bold" Margin="0,0,0,8" />

                        <TextBlock Margin="0,2">
                            <Run Text="{Binding PrepVerified, Mode=OneWay, Converter={StaticResource BoolToCheckmarkConverter}}" Foreground="#38A169" />
                            <Run Text=" Printer state verified" />
                        </TextBlock>
                        <TextBlock Margin="0,2">
                            <Run Text="{Binding PrepCodesReserved, Mode=OneWay, Converter={StaticResource BoolToCheckmarkConverter}}" Foreground="#38A169" />
                            <Run Text=" " /><Run Text="{Binding Quantity, Mode=OneWay}" /><Run Text=" codes reserved from pool" />
                        </TextBlock>
                        <TextBlock Margin="0,2">
                            <Run Text="{Binding PrepDataUploaded, Mode=OneWay, Converter={StaticResource BoolToCheckmarkConverter}}" Foreground="#38A169" />
                            <Run Text=" Data file uploaded to printer" />
                        </TextBlock>
                        <TextBlock Margin="0,2">
                            <Run Text="{Binding PrepTemplateLoaded, Mode=OneWay, Converter={StaticResource BoolToCheckmarkConverter}}" Foreground="#38A169" />
                            <Run Text=" Template loaded successfully" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Success state -->
                <StackPanel Visibility="{Binding PrepComplete, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,0,0,16">
                    <TextBlock Foreground="#38A169" FontWeight="Bold" FontSize="14" Margin="0,0,0,12">
                        <Run Text="Job #" /><Run Text="{Binding CreatedJobId, Mode=OneWay}" /><Run Text=" is ready to print." />
                    </TextBlock>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Start Print" Command="{Binding StartPrintCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,8,0" />
                        <Button Content="Go to Job" Command="{Binding GoToJobCommand}"
                                Style="{StaticResource OutlineButton}" Padding="16,8" />
                    </StackPanel>
                </StackPanel>

                <!-- Error state -->
                <StackPanel Visibility="{Binding PrepFailed, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,0,0,16">
                    <TextBlock Foreground="#E53E3E" TextWrapping="Wrap" Margin="0,0,0,8">
                        <Run Text="Error: " FontWeight="Bold" />
                        <Run Text="{Binding PrepErrorMessage, Mode=OneWay}" />
                    </TextBlock>
                    <Button Content="Retry" Command="{Binding RetryPrepareCommand}"
                            Style="{StaticResource OutlineButton}" Padding="16,8" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- Status message -->
                <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" Opacity="0.7"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
