<UserControl x:Class="CodePrintManager.Desktop.Views.PrintersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CodePrintManager.Desktop.ViewModels"
             xmlns:loc="clr-namespace:CodePrintManager.Desktop.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PrintersViewModel}"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="{loc:Loc Common_NewJob}"
                    Command="{Binding NewJobCommand}"
                    Style="{StaticResource PrimaryButton}" Padding="16,8" />
            <TextBlock Text="{loc:Loc Printers_Title}" Style="{StaticResource PageHeader}" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Printer selector row -->
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="{loc:Loc Printers_AddPrinter}"
                    Command="{Binding ShowAddPrinterCommand}"
                    Style="{StaticResource OutlineButton}" Padding="10,4" Margin="8,0,0,0" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}"
                          DisplayMemberPath="Name" MinWidth="200" />
                <TextBlock Text="{Binding SelectedPrinter.IpAddress}" Margin="12,0,0,0"
                           VerticalAlignment="Center" Opacity="0.6" />
                <Ellipse Style="{StaticResource StatusDot}" Margin="12,0,6,0"
                         Fill="{Binding SelectedPrinterStatus, Converter={StaticResource StatusToColorConverter}}" />
                <TextBlock Text="{Binding SelectedPrinterStatus}" VerticalAlignment="Center"
                           Foreground="{Binding SelectedPrinterStatus, Converter={StaticResource StatusToColorConverter}}"
                           FontWeight="SemiBold" />
            </StackPanel>
        </DockPanel>

        <!-- Add Printer inline form -->
        <Border Grid.Row="2" Margin="0,0,0,8"
                Visibility="{Binding IsAddingPrinter, Converter={StaticResource BoolToVisibilityConverter}}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12"
                VerticalAlignment="Top" HorizontalAlignment="Left" MinWidth="350">
            <StackPanel>
                <TextBlock Text="{loc:Loc Printers_AddNewPrinter}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                <TextBlock Text="{loc:Loc Printers_Label_Name}" Margin="0,0,0,2" />
                <TextBox Text="{Binding NewPrinterName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                <TextBlock Text="{loc:Loc Printers_Label_IpAddress}" Margin="0,0,0,2" />
                <TextBox Text="{Binding NewPrinterIp, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                <TextBlock Text="{loc:Loc Printers_Label_Port}" Margin="0,0,0,2" />
                <TextBox Text="{Binding NewPrinterPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                <TextBlock Text="{loc:Loc Printers_Label_AdapterType}" Margin="0,0,0,2" />
                <ComboBox ItemsSource="{Binding AvailableAdapterTypes}"
                          SelectedItem="{Binding NewPrinterAdapterType}"
                          Margin="0,0,0,12" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="{loc:Loc Common_Add}" Command="{Binding ConfirmAddPrinterCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,0,8,0" />
                    <Button Content="{loc:Loc Common_Cancel}" Command="{Binding CancelAddPrinterCommand}"
                            Style="{StaticResource OutlineButton}" Padding="16,6" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Tabs: Configuration / Storage -->
        <TabControl Grid.Row="2"
                    Visibility="{Binding SelectedPrinter, Converter={StaticResource NullToVisibilityConverter}}">
            <!-- Configuration Tab -->
            <TabItem Header="{loc:Loc Printers_Tab_Configuration}">
                <StackPanel Margin="12">
                    <!-- Read-only view (not editing) -->
                    <StackPanel Visibility="{Binding IsEditingPrinter, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Printers_Label_Name}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPrinter.Name}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Printers_Label_IpAddress}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPrinter.IpAddress}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Printers_Label_Port}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPrinter.Port}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Printers_Label_AdapterType}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPrinter.AdapterType}" />
                        </Grid>
                    </StackPanel>

                    <!-- Edit view (editing) -->
                    <StackPanel Visibility="{Binding IsEditingPrinter, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="250" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Printers_Label_Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding EditPrinterName, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="250" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Printers_Label_IpAddress}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding EditPrinterIp, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="250" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Printers_Label_Port}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding EditPrinterPort, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Printers_Label_AdapterType}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPrinter.AdapterType}" />
                        </Grid>
                    </StackPanel>

                    <Separator Margin="0,12" />

                    <StackPanel Orientation="Horizontal">
                        <!-- Normal mode buttons -->
                        <Button Content="{loc:Loc Printers_Connect}" Command="{Binding ConnectPrinterCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,8,0"
                                Visibility="{Binding IsEditingPrinter, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}" />
                        <Button Content="{loc:Loc Printers_Disconnect}" Command="{Binding DisconnectPrinterCommand}"
                                Style="{StaticResource OutlineButton}" Padding="12,6" Margin="0,0,8,0"
                                Visibility="{Binding IsEditingPrinter, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}" />
                        <Button Content="{loc:Loc Printers_Edit}" Command="{Binding EditPrinterCommand}"
                                Style="{StaticResource OutlineButton}" Padding="12,6" Margin="0,0,8,0"
                                Visibility="{Binding IsEditingPrinter, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}" />
                        <Button Content="{loc:Loc Printers_DeletePrinter}" Command="{Binding DeletePrinterCommand}"
                                Style="{StaticResource DangerButton}" Padding="12,6"
                                Visibility="{Binding IsEditingPrinter, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}" />
                        <!-- Edit mode buttons -->
                        <Button Content="{loc:Loc Common_Save}" Command="{Binding SaveEditPrinterCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,8,0"
                                Visibility="{Binding IsEditingPrinter, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button Content="{loc:Loc Common_Cancel}" Command="{Binding CancelEditPrinterCommand}"
                                Style="{StaticResource OutlineButton}" Padding="12,6"
                                Visibility="{Binding IsEditingPrinter, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Storage Tab -->
            <TabItem Header="{loc:Loc Printers_Tab_Storage}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel>
                        <!-- Templates on Printer -->
                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="{loc:Loc Common_Refresh}"
                                    Command="{Binding RefreshStorageCommand}"
                                    Style="{StaticResource OutlineButton}" Padding="10,4" />
                            <TextBlock Text="{loc:Loc Printers_TemplatesOnPrinter}" Style="{StaticResource SectionHeader}" Margin="0" />
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding TemplateFiles}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" IsReadOnly="False" HeadersVisibility="Column"
                                  Margin="0,0,0,16">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding IsProtected, Converter={StaticResource InverseBoolConverter}}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Loc Printers_Col_Name}" Binding="{Binding FileName}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="{loc:Loc Printers_Col_Status}" Binding="{Binding StatusText}" Width="200" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- CSV Files on Printer -->
                        <TextBlock Text="{loc:Loc Printers_CsvFilesOnPrinter}" Style="{StaticResource SectionHeader}" />
                        <DataGrid ItemsSource="{Binding CsvFiles}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" IsReadOnly="False" HeadersVisibility="Column"
                                  Margin="0,0,0,16">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding IsProtected, Converter={StaticResource InverseBoolConverter}}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Loc Printers_Col_Name}" Binding="{Binding FileName}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="{loc:Loc Printers_Col_Status}" Binding="{Binding StatusText}" Width="200" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Button Command="{Binding DeleteSelectedFilesCommand}"
                                Style="{StaticResource DangerButton}" Padding="12,6" HorizontalAlignment="Left">
                            <TextBlock>
                                <Run Text="{loc:Loc Printers_DeleteSelectedCount}" /><Run Text="{Binding SelectedDeleteCount, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Verify Tab -->
            <TabItem Header="{loc:Loc Printers_Tab_Verify}">
                <StackPanel Margin="12">
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding VerifyOverallStatus}"
                                   FontWeight="Bold" FontSize="14" VerticalAlignment="Center"
                                   Visibility="{Binding HasVerifyResults, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button Content="{loc:Loc Printers_RunVerification}" Command="{Binding VerifyPrinterCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="14,6" HorizontalAlignment="Left"
                                IsEnabled="{Binding IsVerifying, Converter={StaticResource InverseBoolConverter}}" />
                    </DockPanel>

                    <TextBlock Text="{loc:Loc Printers_CheckingPrinter}" Opacity="0.6" Margin="0,0,0,8"
                               Visibility="{Binding IsVerifying, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- Results -->
                    <ItemsControl ItemsSource="{Binding VerifyResults}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,0,0,4"
                                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding StatusIcon}"
                                                   FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding CheckName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Details}" Opacity="0.7" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
