<UserControl x:Class="CodePrintManager.Desktop.Views.PrintersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CodePrintManager.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PrintersViewModel}"
             Loaded="OnLoaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Printer List -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Printers" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ListBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}"
                     DisplayMemberPath="Name" />
        </DockPanel>

        <!-- Printer Config / Actions -->
        <StackPanel Grid.Column="1" Margin="16,0,0,0">
            <!-- Add Printer Form -->
            <GroupBox Header="Add Printer" Margin="0,0,0,16">
                <StackPanel Margin="8">
                    <TextBlock Text="Name" />
                    <TextBox Text="{Binding NewPrinterName}" Margin="0,2,0,8" />
                    <TextBlock Text="IP Address" />
                    <TextBox Text="{Binding NewPrinterIp}" Margin="0,2,0,8" />
                    <TextBlock Text="Port" />
                    <TextBox Text="{Binding NewPrinterPort}" Margin="0,2,0,8" />
                    <TextBlock Text="Adapter Type" />
                    <TextBox Text="{Binding NewPrinterAdapterType}" Margin="0,2,0,8" />
                    <Button Content="Add" Command="{Binding AddPrinterCommand}"
                            HorizontalAlignment="Left" Padding="16,6" />
                </StackPanel>
            </GroupBox>

            <!-- Selected Printer Actions -->
            <GroupBox Header="Actions"
                      Visibility="{Binding SelectedPrinter, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Margin="8">
                    <Button Content="Connect" Command="{Binding ConnectPrinterCommand}" Padding="12,6" Margin="0,0,8,0" />
                    <Button Content="Disconnect" Command="{Binding DisconnectPrinterCommand}" Padding="12,6" Margin="0,0,8,0" />
                    <Button Content="Delete" Command="{Binding DeletePrinterCommand}" Padding="12,6" Foreground="Red" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>
</UserControl>
