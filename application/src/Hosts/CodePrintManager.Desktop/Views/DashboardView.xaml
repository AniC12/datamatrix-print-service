<UserControl x:Class="CodePrintManager.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CodePrintManager.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="+ New Job"
                    Command="{Binding NewJobCommand}"
                    Style="{StaticResource PrimaryButton}" Padding="16,8" />
            <TextBlock Text="DASHBOARD" Style="{StaticResource PageHeader}" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Main content: scrollable -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Printer Cards (full-width, stacked) -->
                <ItemsControl ItemsSource="{Binding PrinterCards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DashboardPrinterCard}"
                                    MouseLeftButtonUp="OnPrinterCardClick">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Row 1: Printer name, IP, status -->
                                    <DockPanel Grid.Row="0">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,6,0"
                                                     Fill="{Binding JobStatus, Converter={StaticResource StatusToColorConverter}}" />
                                            <TextBlock Text="{Binding JobStatus}" FontWeight="SemiBold"
                                                       Foreground="{Binding JobStatus, Converter={StaticResource StatusToColorConverter}}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" />
                                            <TextBlock Text="{Binding IpAddress}" Opacity="0.5" Margin="12,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Row 2: Job info + progress text -->
                                    <DockPanel Grid.Row="1" Margin="0,6,0,0"
                                               Visibility="{Binding HasJob, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}"
                                                   Opacity="0.7" VerticalAlignment="Center" />
                                        <TextBlock>
                                            <Run Text="Job #" /><Run Text="{Binding JobId, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding JobProductName, Mode=OneWay}" />
                                        </TextBlock>
                                    </DockPanel>

                                    <!-- Row 3: Progress bar + action buttons OR summary text -->
                                    <DockPanel Grid.Row="2" Margin="0,6,0,0"
                                               Visibility="{Binding HasJob, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <!-- Action buttons (right-aligned) -->
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                            <Button Content="Start Print" Command="{Binding StartPrintCommand}"
                                                    Style="{StaticResource PrimaryButton}" Padding="10,4" Margin="0,0,4,0"
                                                    Visibility="{Binding JobStatus, Converter={StaticResource JobStatusToActionVisibilityConverter}, ConverterParameter=StartPrint}" />
                                            <Button Content="Pause" Command="{Binding PauseJobCommand}"
                                                    Style="{StaticResource OutlineButton}" Padding="10,4" Margin="0,0,4,0"
                                                    Visibility="{Binding JobStatus, Converter={StaticResource JobStatusToActionVisibilityConverter}, ConverterParameter=Pause}" />
                                            <Button Content="Resume" Command="{Binding ResumeJobCommand}"
                                                    Style="{StaticResource PrimaryButton}" Padding="10,4" Margin="0,0,4,0"
                                                    Visibility="{Binding JobStatus, Converter={StaticResource JobStatusToActionVisibilityConverter}, ConverterParameter=Resume}" />
                                            <Button Content="Cancel" Command="{Binding CancelJobCommand}"
                                                    Style="{StaticResource DangerButton}" Padding="10,4"
                                                    Visibility="{Binding JobStatus, Converter={StaticResource JobStatusToActionVisibilityConverter}, ConverterParameter=Cancel}" />
                                        </StackPanel>

                                        <!-- Progress bar (active jobs) or summary text (completed) -->
                                        <Grid>
                                            <ProgressBar Value="{Binding CurrentJobProgress}" Maximum="{Binding CurrentJobTotal}"
                                                         Height="8" VerticalAlignment="Center"
                                                         Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock Text="{Binding JobSummaryText}" Opacity="0.6"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding JobSummaryText, Converter={StaticResource NullToVisibilityConverter}}" />
                                        </Grid>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Recent Activity -->
                <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource SectionHeader}" Margin="0,24,0,8" />
                <ItemsControl ItemsSource="{Binding RecentActivity}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,2" Opacity="0.8">
                                <Run Text="{Binding Time, Mode=OneTime}" FontWeight="SemiBold" />
                                <Run Text="  " />
                                <Run Text="{Binding Description, Mode=OneTime}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
