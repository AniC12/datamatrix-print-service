<UserControl x:Class="CodePrintManager.Desktop.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CodePrintManager.Desktop.ViewModels"
             xmlns:loc="clr-namespace:CodePrintManager.Desktop.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProductsViewModel}"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="{loc:Loc Products_Title}" Style="{StaticResource PageHeader}" Margin="0,0,0,12" />

        <!-- Split panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Tree Panel -->
            <DockPanel Grid.Column="0" Margin="0,0,12,0">

                <!-- Toolbar: [+F] [+P] -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="{loc:Loc Products_AddFolder}" Command="{Binding ShowAddFolderCommand}"
                            Style="{StaticResource OutlineButton}" Padding="8,4" Margin="0,0,6,0" FontSize="11" />
                    <Button Content="{loc:Loc Products_AddProduct}" Command="{Binding ShowAddProductCommand}"
                            Style="{StaticResource OutlineButton}" Padding="8,4" FontSize="11" />
                </StackPanel>

                <!-- "Adding to" hint -->
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontSize="11" Opacity="0.6">
                    <Run Text="{loc:Loc Products_AddingTo}" />
                    <Run Text="{Binding AddTargetHint}" FontWeight="SemiBold" />
                </TextBlock>

                <!-- Add Folder inline form -->
                <Border DockPanel.Dock="Top" Margin="0,0,0,8"
                        Visibility="{Binding IsAddingFolder, Converter={StaticResource BoolToVisibilityConverter}}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Products_NewFolderName}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewNodeName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{loc:Loc Common_Create}" Command="{Binding ConfirmAddFolderCommand}"
                                    Style="{StaticResource PrimaryButton}" Padding="10,4" Margin="0,0,8,0" />
                            <Button Content="{loc:Loc Common_Cancel}" Command="{Binding CancelAddCommand}"
                                    Style="{StaticResource OutlineButton}" Padding="10,4" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Add Product inline form -->
                <Border DockPanel.Dock="Top" Margin="0,0,0,8"
                        Visibility="{Binding IsAddingProduct, Converter={StaticResource BoolToVisibilityConverter}}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Products_NewProductName}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewNodeName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Loc Products_TemplateFile}" Margin="0,4,0,4" />
                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="{loc:Loc Common_Browse}"
                                    Command="{Binding BrowseNewTemplateCommand}"
                                    Style="{StaticResource OutlineButton}" Padding="6,2" Margin="4,0,0,0" FontSize="11" />
                            <TextBox Text="{Binding NewProductTemplate, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Text="{loc:Loc Products_PrinterCsvName}" Margin="0,4,0,4" />
                        <TextBox Text="{Binding NewProductCsvName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{loc:Loc Common_Create}" Command="{Binding ConfirmAddProductCommand}"
                                    Style="{StaticResource PrimaryButton}" Padding="10,4" Margin="0,0,8,0" />
                            <Button Content="{loc:Loc Common_Cancel}" Command="{Binding CancelAddCommand}"
                                    Style="{StaticResource OutlineButton}" Padding="10,4" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Unassigned Codes (below tree) -->
                <Separator DockPanel.Dock="Bottom" Margin="0,8,0,4"
                           Visibility="{Binding UnassignedCodesCount, Converter={StaticResource CountToVisibilityConverter}}" />
                <Button DockPanel.Dock="Bottom" Style="{StaticResource LinkButton}"
                        Command="{Binding ShowUnassignedCodesCommand}"
                        HorizontalContentAlignment="Left" Padding="4,4,4,4"
                        Visibility="{Binding UnassignedCodesCount, Converter={StaticResource CountToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="!" FontWeight="Bold" Foreground="#DD6B20" Margin="0,0,6,0" />
                        <TextBlock>
                            <Run Text="{loc:Loc Products_Unassigned}" />
                            <Run Text="{Binding UnassignedCodesCount, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text="{loc:Loc Products_Codes}" />
                        </TextBlock>
                    </StackPanel>
                </Button>

                <!-- Product Tree (always expanded) -->
                <TreeView x:Name="ProductTree" ItemsSource="{Binding Products}"
                          SelectedItemChanged="OnTreeSelectionChanged"
                          MouseDown="OnTreeBackgroundClick">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <!-- Right: Detail Pane with Tabs -->
            <Grid Grid.Column="1">

                <!-- Unassigned Codes mode -->
                <StackPanel Visibility="{Binding IsShowingUnassigned, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{loc:Loc Products_UnassignedCodes}" FontSize="18" FontWeight="Bold" />
                    <Separator Margin="0,8,0,12" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding CodesTab}">
                        <StackPanel>
                            <!-- Filter Toolbar -->
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="{loc:Loc Common_Refresh}"
                                        Command="{Binding LoadCodesCommand}"
                                        Style="{StaticResource OutlineButton}" Padding="10,4" Margin="8,0,0,0" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Loc Products_Label_Status}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                                              SelectedItem="{Binding SelectedStatusFilterText}"
                                              Width="120" Margin="0,0,16,0" />
                                    <TextBlock Text="{loc:Loc Products_Label_Search}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Width="200" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Codes DataGrid -->
                            <DataGrid ItemsSource="{Binding Codes}" AutoGenerateColumns="False"
                                      CanUserAddRows="False" IsReadOnly="False" HeadersVisibility="Column"
                                      MinHeight="200" MaxHeight="400"
                                      EnableRowVirtualization="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding IsReserved, Converter={StaticResource InverseBoolConverter}}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{loc:Loc Products_Col_CodeText}" Binding="{Binding CodeText}" Width="*" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="ToolTip" Value="{Binding CodeText}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="{loc:Loc Products_Col_Status}" Width="100" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}"
                                                           Foreground="{Binding Status, Converter={StaticResource CodeStatusToColorConverter}}"
                                                           FontWeight="SemiBold" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{loc:Loc Products_Col_Batch}" Binding="{Binding ImportBatch}" Width="100" IsReadOnly="True" />
                                    <DataGridTextColumn Header="{loc:Loc Products_Col_Job}" Binding="{Binding JobId, StringFormat='#{0}', TargetNullValue='—'}" Width="60" IsReadOnly="True" />
                                    <DataGridTextColumn Header="{loc:Loc Products_Col_Changed}" Binding="{Binding StatusChangedAt, StringFormat='MMM dd HH:mm'}" Width="110" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Pagination -->
                            <DockPanel Margin="0,8,0,0">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Button Content="{loc:Loc Common_SelectAll}" Command="{Binding SelectAllCommand}"
                                            Style="{StaticResource LinkButton}" Padding="4,2" Margin="0,0,8,0" />
                                    <Button Content="{loc:Loc Common_DeselectAll}" Command="{Binding DeselectAllCommand}"
                                            Style="{StaticResource LinkButton}" Padding="4,2" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Run Text="{loc:Loc Products_PageInfo}" />
                                        <Run Text="{Binding CurrentPage, Mode=OneWay}" />
                                        <Run Text="/" />
                                        <Run Text="{Binding TotalPages, Mode=OneWay}" />
                                        <Run Text=" (" />
                                        <Run Text="{Binding TotalCount, Mode=OneWay}" />
                                        <Run Text="{loc:Loc Products_PageTotal}" />
                                    </TextBlock>
                                    <TextBlock Text="{loc:Loc Products_Show}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <ComboBox ItemsSource="{Binding PageSizeOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedPageSize}"
                                              Width="70" Margin="0,0,8,0" />
                                    <Button Content="{loc:Loc Common_Prev}" Command="{Binding PreviousPageCommand}"
                                            IsEnabled="{Binding CanGoPrevious}"
                                            Style="{StaticResource OutlineButton}" Padding="8,4" Margin="0,0,4,0" FontSize="11" />
                                    <Button Content="{loc:Loc Common_Next}" Command="{Binding NextPageCommand}"
                                            IsEnabled="{Binding CanGoNext}"
                                            Style="{StaticResource OutlineButton}" Padding="8,4" FontSize="11" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Actions on selected -->
                            <Border Margin="0,12,0,0" Padding="8" CornerRadius="4"
                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,8">
                                        <Run Text="{loc:Loc Products_ActionsOnSelected}" />
                                        <Run Text="{Binding SelectedCount, Mode=OneWay}" />
                                        <Run Text=")" />
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{loc:Loc Products_ChangeTo}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{Binding StatusChangeOptions}"
                                                  SelectedItem="{Binding SelectedNewStatus}"
                                                  Width="120" Margin="0,0,8,0" />
                                        <Button Content="{loc:Loc Common_Apply}" Command="{Binding ApplyStatusChangeCommand}"
                                                Style="{StaticResource PrimaryButton}" Padding="10,4" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{loc:Loc Products_MoveTo}" VerticalAlignment="Center" Margin="0,0,6,0" Width="65" />
                                        <ComboBox ItemsSource="{Binding LeafProducts}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding MoveTargetProduct}"
                                                  Width="120" Margin="0,0,8,0" />
                                        <Button Content="{loc:Loc Common_Move}" Command="{Binding MoveSelectedCommand}"
                                                Style="{StaticResource OutlineButton}" Padding="10,4" />
                                    </StackPanel>
                                    <Button Content="{loc:Loc Common_ArchiveSelected}" Command="{Binding ArchiveSelectedCommand}"
                                            Style="{StaticResource DangerButton}" Padding="10,4"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <!-- Undo Bar -->
                            <Border Margin="0,8,0,0" Padding="8" CornerRadius="4"
                                    Background="#F7FAFC"
                                    Visibility="{Binding LastOperationSummary, Converter={StaticResource NullToVisibilityConverter}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{loc:Loc Common_Undo}" Command="{Binding UndoCommand}"
                                            IsEnabled="{Binding CanUndo}"
                                            Style="{StaticResource OutlineButton}" Padding="10,4" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding LastOperationSummary}" VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>

                <!-- Product selected -->
                <StackPanel Visibility="{Binding SelectedProduct, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding SelectedProduct.Name}" FontSize="18" FontWeight="Bold" />
                    <Separator Margin="0,8,0,12" />

                    <!-- Leaf product: show tabs -->
                    <TabControl Visibility="{Binding SelectedProduct.IsLeaf, Converter={StaticResource BoolToVisibilityConverter}}"
                                BorderThickness="0,1,0,0" Padding="0,12,0,0">

                        <!-- Operations Tab -->
                        <TabItem Header="{loc:Loc Products_Tab_Operations}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                <StackPanel>
                                    <!-- Code Pool Stats -->
                                    <TextBlock Text="{loc:Loc Products_CodePool}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                    <Grid Margin="16,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Products_Available}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AvailableCodesCount}" FontWeight="Bold" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Products_Printed}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PrintedCodesCount}" FontWeight="Bold" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Products_Burned}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BurnedCodesCount}" FontWeight="Bold" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Products_Quarantined}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding QuarantinedCodesCount}" FontWeight="Bold"
                                                   Foreground="#FF9800" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Products_Total}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TotalCodesCount}" FontWeight="Bold" />
                                    </Grid>

                                    <!-- Action buttons -->
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Content="{loc:Loc Common_ImportCsv}" Command="{Binding ImportCsvCommand}"
                                                Style="{StaticResource OutlineButton}" Margin="0,0,8,0" />
                                        <Button Content="{loc:Loc Common_NewJob}" Command="{Binding NewJobCommand}"
                                                IsEnabled="{Binding CanCreateNewJob}"
                                                ToolTip="{Binding AvailableCodesCount, StringFormat='Available: {0}'}"
                                                Style="{StaticResource PrimaryButton}" />
                                    </StackPanel>

                                    <!-- Activity History (merged imports + jobs) -->
                                    <TextBlock Text="{loc:Loc Products_History}" Style="{StaticResource SectionHeader}" />
                                    <ItemsControl ItemsSource="{Binding ActivityHistory}" Margin="8,0,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
                                                             Fill="{Binding TypeBrush}" />
                                                    <TextBlock VerticalAlignment="Center">
                                                        <Run Text="{Binding DateText, Mode=OneTime}" FontWeight="SemiBold" Foreground="#4A5568" />
                                                        <Run Text="  " />
                                                        <Run Text="{Binding Description, Mode=OneTime}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Settings Tab -->
                        <TabItem Header="{loc:Loc Products_Tab_Settings}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                <StackPanel>
                                    <!-- Rename -->
                                    <TextBlock Text="{loc:Loc Products_Label_Name}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                    <Grid Margin="16,0,0,0"
                                          Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SelectedProduct.Name}" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" />
                                        <Button Grid.Column="1" Content="{loc:Loc Common_Rename}" Command="{Binding ShowRenameCommand}"
                                                Style="{StaticResource OutlineButton}" Padding="8,4" Margin="8,0,0,0" FontSize="11" />
                                    </Grid>
                                    <Grid Margin="16,0,0,0"
                                          Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalAlignment="Center" Padding="2" />
                                        <Button Grid.Column="1" Content="{loc:Loc Common_Save}" Command="{Binding ConfirmRenameCommand}"
                                                Style="{StaticResource PrimaryButton}" Padding="8,4" Margin="8,0,4,0" FontSize="11" />
                                        <Button Grid.Column="2" Content="{loc:Loc Common_Cancel}" Command="{Binding CancelRenameCommand}"
                                                Style="{StaticResource OutlineButton}" Padding="8,4" FontSize="11" />
                                    </Grid>

                                    <!-- Template -->
                                    <TextBlock Text="{loc:Loc Products_Label_TemplateFile}" Style="{StaticResource SectionHeader}" Margin="0,12,0,8" />
                                    <Grid Margin="16,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SelectedProduct.TemplateFile, TargetNullValue='(not set)'}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.8" />
                                        <Button Grid.Column="1" Content="{loc:Loc Common_Edit}" Command="{Binding ChangeTemplateCommand}"
                                                Style="{StaticResource OutlineButton}" Padding="8,4" Margin="8,0,0,0" FontSize="11" />
                                    </Grid>

                                    <!-- CSV Name -->
                                    <TextBlock Text="{loc:Loc Products_PrinterCsvName}" Style="{StaticResource SectionHeader}" Margin="0,12,0,8" />
                                    <Grid Margin="16,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SelectedProduct.PrinterCsvName, UpdateSourceTrigger=LostFocus}"
                                                 VerticalAlignment="Center" BorderThickness="0,0,0,1" Padding="2" />
                                        <Button Grid.Column="1" Content="{loc:Loc Common_Save}" Command="{Binding SaveCsvNameCommand}"
                                                Style="{StaticResource OutlineButton}" Padding="8,4" Margin="8,0,0,0" FontSize="11" />
                                    </Grid>

                                    <!-- Danger Zone -->
                                    <Separator Margin="0,24,0,0" />
                                    <TextBlock Text="{loc:Loc Products_DangerZone}" Foreground="#E53E3E" FontWeight="SemiBold"
                                               FontSize="13" Margin="0,12,0,8" />
                                    <Button Content="{loc:Loc Products_DeleteProduct}" Command="{Binding DeleteProductCommand}"
                                            IsEnabled="{Binding CanDeleteSelectedProduct}"
                                            ToolTip="{Binding DeleteBlockedReason}"
                                            Style="{StaticResource DangerButton}" Padding="12,6"
                                            HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding DeleteBlockedReason}" Foreground="#E53E3E"
                                               FontSize="11" Margin="0,4,0,0" Opacity="0.8"
                                               Visibility="{Binding DeleteBlockedReason, Converter={StaticResource NullToVisibilityConverter}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <!-- Codes Tab -->
                        <TabItem Header="{loc:Loc Products_Tab_Codes}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"
                                          DataContext="{Binding CodesTab}">
                                <StackPanel>
                                    <!-- Filter Toolbar -->
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="{loc:Loc Common_Refresh}"
                                                Command="{Binding LoadCodesCommand}"
                                                Style="{StaticResource OutlineButton}" Padding="10,4" Margin="8,0,0,0" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{loc:Loc Products_Label_Status}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                                                      SelectedItem="{Binding SelectedStatusFilterText}"
                                                      Width="120" Margin="0,0,16,0" />
                                            <TextBlock Text="{loc:Loc Products_Label_Search}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="200" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Codes DataGrid -->
                                    <DataGrid ItemsSource="{Binding Codes}" AutoGenerateColumns="False"
                                              CanUserAddRows="False" IsReadOnly="False" HeadersVisibility="Column"
                                              MinHeight="200" MaxHeight="400"
                                              EnableRowVirtualization="True">
                                        <DataGrid.Columns>
                                            <!-- Checkbox -->
                                            <DataGridTemplateColumn Width="40">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding IsReserved, Converter={StaticResource InverseBoolConverter}}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <!-- Code Text -->
                                            <DataGridTextColumn Header="{loc:Loc Products_Col_CodeText}" Binding="{Binding CodeText}" Width="*" IsReadOnly="True">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                        <Setter Property="ToolTip" Value="{Binding CodeText}" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <!-- Status -->
                                            <DataGridTemplateColumn Header="{loc:Loc Products_Col_Status}" Width="100" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Status}"
                                                                   Foreground="{Binding Status, Converter={StaticResource CodeStatusToColorConverter}}"
                                                                   FontWeight="SemiBold" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <!-- Batch -->
                                            <DataGridTextColumn Header="{loc:Loc Products_Col_Batch}" Binding="{Binding ImportBatch}" Width="100" IsReadOnly="True" />
                                            <!-- Job -->
                                            <DataGridTextColumn Header="{loc:Loc Products_Col_Job}" Binding="{Binding JobId, StringFormat='#{0}', TargetNullValue='—'}" Width="60" IsReadOnly="True" />
                                            <!-- Changed -->
                                            <DataGridTextColumn Header="{loc:Loc Products_Col_Changed}" Binding="{Binding StatusChangedAt, StringFormat='MMM dd HH:mm'}" Width="110" IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Pagination Bar -->
                                    <DockPanel Margin="0,8,0,0">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                            <Button Content="{loc:Loc Common_SelectAll}" Command="{Binding SelectAllCommand}"
                                                    Style="{StaticResource LinkButton}" Padding="4,2" Margin="0,0,8,0" />
                                            <Button Content="{loc:Loc Common_DeselectAll}" Command="{Binding DeselectAllCommand}"
                                                    Style="{StaticResource LinkButton}" Padding="4,2" />
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Run Text="{loc:Loc Products_PageInfo}" />
                                                <Run Text="{Binding CurrentPage, Mode=OneWay}" />
                                                <Run Text="/" />
                                                <Run Text="{Binding TotalPages, Mode=OneWay}" />
                                                <Run Text=" (" />
                                                <Run Text="{Binding TotalCount, Mode=OneWay}" />
                                                <Run Text="{loc:Loc Products_PageTotal}" />
                                            </TextBlock>
                                            <TextBlock Text="{loc:Loc Products_Show}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <ComboBox ItemsSource="{Binding PageSizeOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding SelectedPageSize}"
                                                      Width="70" Margin="0,0,8,0" />
                                            <Button Content="{loc:Loc Common_Prev}" Command="{Binding PreviousPageCommand}"
                                                    IsEnabled="{Binding CanGoPrevious}"
                                                    Style="{StaticResource OutlineButton}" Padding="8,4" Margin="0,0,4,0" FontSize="11" />
                                            <Button Content="{loc:Loc Common_Next}" Command="{Binding NextPageCommand}"
                                                    IsEnabled="{Binding CanGoNext}"
                                                    Style="{StaticResource OutlineButton}" Padding="8,4" FontSize="11" />
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Actions Panel: Selected -->
                                    <Border Margin="0,12,0,0" Padding="8" CornerRadius="4"
                                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Margin="0,0,0,8">
                                                <Run Text="{loc:Loc Products_ActionsOnSelected}" />
                                                <Run Text="{Binding SelectedCount, Mode=OneWay}" />
                                                <Run Text=")" />
                                            </TextBlock>
                                            <!-- Change status -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{loc:Loc Products_ChangeTo}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <ComboBox ItemsSource="{Binding StatusChangeOptions}"
                                                          SelectedItem="{Binding SelectedNewStatus}"
                                                          Width="120" Margin="0,0,8,0" />
                                                <Button Content="{loc:Loc Common_Apply}" Command="{Binding ApplyStatusChangeCommand}"
                                                        Style="{StaticResource PrimaryButton}" Padding="10,4" />
                                            </StackPanel>
                                            <!-- Move -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{loc:Loc Products_MoveTo}" VerticalAlignment="Center" Margin="0,0,6,0" Width="65" />
                                                <ComboBox ItemsSource="{Binding LeafProducts}"
                                                          DisplayMemberPath="Name"
                                                          SelectedItem="{Binding MoveTargetProduct}"
                                                          Width="120" Margin="0,0,8,0" />
                                                <Button Content="{loc:Loc Common_Move}" Command="{Binding MoveSelectedCommand}"
                                                        Style="{StaticResource OutlineButton}" Padding="10,4" />
                                            </StackPanel>
                                            <!-- Archive -->
                                            <Button Content="{loc:Loc Common_ArchiveSelected}" Command="{Binding ArchiveSelectedCommand}"
                                                    Style="{StaticResource DangerButton}" Padding="10,4"
                                                    HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Actions Panel: Bulk (visible only with specific status filter) -->
                                    <Border Margin="0,8,0,0" Padding="8" CornerRadius="4"
                                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                            Visibility="{Binding SelectedStatusFilterText, Converter={StaticResource NullToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Margin="0,0,0,8">
                                                <Run Text="{loc:Loc Products_BulkAll}" />
                                                <Run Text="{Binding TotalCount, Mode=OneWay}" />
                                                <Run Text=" &quot;" />
                                                <Run Text="{Binding SelectedStatusFilterText, Mode=OneWay}" />
                                                <Run Text="{loc:Loc Products_Codes}" />
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{loc:Loc Products_ChangeAllTo}" Command="{Binding ApplyBulkStatusChangeCommand}"
                                                        Style="{StaticResource OutlineButton}" Padding="10,4" Margin="0,0,6,0" />
                                                <Button Content="{loc:Loc Products_MoveAllTo}" Command="{Binding MoveAllFilteredCommand}"
                                                        Style="{StaticResource OutlineButton}" Padding="10,4" Margin="0,0,6,0" />
                                                <Button Content="{loc:Loc Products_ArchiveAll}" Command="{Binding ArchiveAllFilteredCommand}"
                                                        Style="{StaticResource DangerButton}" Padding="10,4" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Undo Bar -->
                                    <Border Margin="0,8,0,0" Padding="8" CornerRadius="4"
                                            Background="#F7FAFC"
                                            Visibility="{Binding LastOperationSummary, Converter={StaticResource NullToVisibilityConverter}}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="{loc:Loc Common_Undo}" Command="{Binding UndoCommand}"
                                                    IsEnabled="{Binding CanUndo}"
                                                    Style="{StaticResource OutlineButton}" Padding="10,4" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding LastOperationSummary}" VerticalAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <!-- Folder selected (non-leaf): show rename + info -->
                    <StackPanel Visibility="{Binding SelectedProduct.IsLeaf, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                        <!-- Folder Rename -->
                        <TextBlock Text="{loc:Loc Products_Label_Name}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                        <Grid Margin="16,0,0,0"
                              Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SelectedProduct.Name}" VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                            <Button Grid.Column="1" Content="{loc:Loc Common_Rename}" Command="{Binding ShowRenameCommand}"
                                    Style="{StaticResource OutlineButton}" Padding="8,4" Margin="8,0,0,0" FontSize="11" />
                        </Grid>
                        <Grid Margin="16,0,0,0"
                              Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" Padding="2" />
                            <Button Grid.Column="1" Content="{loc:Loc Common_Save}" Command="{Binding ConfirmRenameCommand}"
                                    Style="{StaticResource PrimaryButton}" Padding="8,4" Margin="8,0,4,0" FontSize="11" />
                            <Button Grid.Column="2" Content="{loc:Loc Common_Cancel}" Command="{Binding CancelRenameCommand}"
                                    Style="{StaticResource OutlineButton}" Padding="8,4" FontSize="11" />
                        </Grid>

                        <Separator Margin="0,12,0,8" />
                        <TextBlock Text="{loc:Loc Products_FolderInfo}" Opacity="0.6" FontStyle="Italic" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
