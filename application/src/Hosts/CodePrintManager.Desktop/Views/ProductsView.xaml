<UserControl x:Class="CodePrintManager.Desktop.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CodePrintManager.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProductsViewModel}"
             Loaded="OnLoaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Product Tree -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Products" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TreeView ItemsSource="{Binding Products}"
                      SelectedItemChanged="OnTreeSelectionChanged">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Name}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </DockPanel>

        <!-- Product Details -->
        <StackPanel Grid.Column="1" Margin="16,0,0,0"
                    Visibility="{Binding SelectedProduct, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding SelectedProduct.Name}" FontSize="18" FontWeight="Bold" />
            <Separator Margin="0,8" />

            <StackPanel Orientation="Horizontal" Margin="0,8">
                <TextBlock Text="Available codes: " />
                <TextBlock Text="{Binding AvailableCodesCount}" FontWeight="Bold" />
                <TextBlock Text=" / " />
                <TextBlock Text="{Binding TotalCodesCount}" />
            </StackPanel>

            <Button Content="Import CSV..." Command="{Binding ImportCsvCommand}"
                    Margin="0,16,0,0" HorizontalAlignment="Left" Padding="16,8" />
        </StackPanel>
    </Grid>
</UserControl>
