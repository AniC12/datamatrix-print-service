<Window x:Class="CodePrintManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CodePrintManager.Desktop.ViewModels"
        xmlns:views="clr-namespace:CodePrintManager.Desktop.Views"
        mc:Ignorable="d"
        Title="Code Print Manager" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navigation Sidebar -->
        <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource SidebarBackground}">
            <StackPanel Margin="0,16">
                <TextBlock Text="Code Print Manager" FontWeight="Bold" FontSize="14"
                           Margin="16,0,16,24" Foreground="{StaticResource SidebarForeground}" />

                <Button Content="Dashboard" Command="{Binding NavigateToCommand}" CommandParameter="Dashboard"
                        Style="{StaticResource NavButton}" />
                <Button Content="Products" Command="{Binding NavigateToCommand}" CommandParameter="Products"
                        Style="{StaticResource NavButton}" />
                <Button Content="Printers" Command="{Binding NavigateToCommand}" CommandParameter="Printers"
                        Style="{StaticResource NavButton}" />
                <Button Content="Jobs" Command="{Binding NavigateToCommand}" CommandParameter="Jobs"
                        Style="{StaticResource NavButton}" />
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <ContentControl Grid.Column="1" Grid.Row="0" Margin="16" Content="{Binding CurrentView}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                    <views:DashboardView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
                    <views:ProductsView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:PrintersViewModel}">
                    <views:PrintersView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:JobsViewModel}">
                    <views:JobsView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:NewJobViewModel}">
                    <views:NewJobView />
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>

        <!-- Alert Bar — spans full width at bottom -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" MaxHeight="120"
                Visibility="{Binding Alerts.Count, Converter={StaticResource CountToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="110">
                <ItemsControl ItemsSource="{Binding Alerts}" Margin="4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2" Padding="8,4" CornerRadius="3"
                                    Background="{Binding Severity, Converter={StaticResource SeverityToBackgroundConverter}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="X" Padding="6,2"
                                            Command="{Binding DataContext.DismissAlertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Style="{StaticResource LinkButton}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{Binding Severity, Converter={StaticResource SeverityToForegroundConverter}}">
                                        <Run Text="{Binding Timestamp, StringFormat=HH:mm, Mode=OneTime}" />
                                        <Run Text="  " />
                                        <Run Text="{Binding Source, Mode=OneTime}" FontWeight="Bold" />
                                        <Run Text=": " />
                                        <Run Text="{Binding Message, Mode=OneTime}" />
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
