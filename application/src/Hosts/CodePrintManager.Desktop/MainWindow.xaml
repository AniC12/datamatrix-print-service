<Window x:Class="CodePrintManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CodePrintManager.Desktop.ViewModels"
        xmlns:views="clr-namespace:CodePrintManager.Desktop.Views"
        xmlns:loc="clr-namespace:CodePrintManager.Desktop.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc App_Title}" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Gesture="Ctrl+D0" Command="{Binding ZoomResetCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}" />
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navigation Sidebar -->
        <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource SidebarBackground}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Margin="0,16">
                    <TextBlock Text="{loc:Loc App_Title}" FontWeight="Bold" FontSize="14"
                               Margin="16,0,16,24" Foreground="{StaticResource SidebarForeground}" />

                    <Button Content="{loc:Loc Nav_Dashboard}" Command="{Binding NavigateToCommand}" CommandParameter="Dashboard"
                            Style="{StaticResource NavButton}" />
                    <Button Content="{loc:Loc Nav_Products}" Command="{Binding NavigateToCommand}" CommandParameter="Products"
                            Style="{StaticResource NavButton}" />
                    <Button Content="{loc:Loc Nav_Printers}" Command="{Binding NavigateToCommand}" CommandParameter="Printers"
                            Style="{StaticResource NavButton}" />
                    <Button Content="{loc:Loc Nav_Jobs}" Command="{Binding NavigateToCommand}" CommandParameter="Jobs"
                            Style="{StaticResource NavButton}" />
                </StackPanel>

                <!-- Zoom controls -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="−" Command="{Binding ZoomOutCommand}"
                                Width="28" Height="28" FontSize="16" FontWeight="Bold" Padding="0"
                                Foreground="{StaticResource SidebarForeground}" Background="Transparent"
                                BorderBrush="#4A5568" BorderThickness="1" Cursor="Hand" />
                        <TextBlock Text="{Binding ZoomPercent}" VerticalAlignment="Center"
                                   Foreground="{StaticResource SidebarForeground}" Margin="10,0"
                                   FontSize="12" Opacity="0.8" MinWidth="36" TextAlignment="Center" />
                        <Button Content="+" Command="{Binding ZoomInCommand}"
                                Width="28" Height="28" FontSize="16" FontWeight="Bold" Padding="0"
                                Foreground="{StaticResource SidebarForeground}" Background="Transparent"
                                BorderBrush="#4A5568" BorderThickness="1" Cursor="Hand" />
                    </StackPanel>
                </StackPanel>

                <!-- Language selector at bottom of sidebar -->
                <ComboBox DockPanel.Dock="Bottom" Margin="16,0,16,16"
                          ItemsSource="{Binding AvailableLanguages}"
                          SelectedItem="{Binding SelectedLanguage}"
                          DisplayMemberPath="DisplayName" />
            </DockPanel>
        </Border>

        <!-- Content Area -->
        <ContentControl Grid.Column="1" Grid.Row="0" Margin="16" Content="{Binding CurrentView}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                    <views:DashboardView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
                    <views:ProductsView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:PrintersViewModel}">
                    <views:PrintersView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:JobsViewModel}">
                    <views:JobsView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:NewJobViewModel}">
                    <views:NewJobView />
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>

        <!-- Alert Bar — spans full width at bottom -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" MaxHeight="120"
                Visibility="{Binding Alerts.Count, Converter={StaticResource CountToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="110">
                <ItemsControl ItemsSource="{Binding Alerts}" Margin="4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2" Padding="8,4" CornerRadius="3"
                                    Background="{Binding Severity, Converter={StaticResource SeverityToBackgroundConverter}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="X" Padding="6,2"
                                            Command="{Binding DataContext.DismissAlertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Style="{StaticResource LinkButton}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{Binding Severity, Converter={StaticResource SeverityToForegroundConverter}}">
                                        <Run Text="{Binding Timestamp, StringFormat=HH:mm, Mode=OneTime}" />
                                        <Run Text="  " />
                                        <Run Text="{Binding Source, Mode=OneTime}" FontWeight="Bold" />
                                        <Run Text=": " />
                                        <Run Text="{Binding Message, Mode=OneTime}" />
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
