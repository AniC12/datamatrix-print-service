<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:CodePrintManager.Desktop.Converters">

    <!-- Colors -->
    <SolidColorBrush x:Key="SidebarBackground" Color="#2D3748" />
    <SolidColorBrush x:Key="SidebarForeground" Color="#E2E8F0" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3182CE" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0" />

    <!-- Converters -->
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
    <converters:StatusToColorConverter x:Key="StatusToColorConverter" />

    <!-- Global Styles -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

</ResourceDictionary>
