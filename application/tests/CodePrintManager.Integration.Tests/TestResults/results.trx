                      SET IsActive = 0,&#xD;
                          Port = -Id,&#xD;
                          Name = Name || ' (deactivated-duplicate)'&#xD;
                      WHERE Id NOT IN (&#xD;
                          SELECT MIN(Id) FROM printers GROUP BY IpAddress, Port&#xD;
                      )&#xD;
                      AND EXISTS (&#xD;
                          SELECT 1 FROM printers p2&#xD;
                          WHERE p2.IpAddress = printers.IpAddress AND p2.Port = printers.Port AND p2.Id != printers.Id&#xD;
